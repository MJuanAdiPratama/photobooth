# =====================================================================
# Qxuan Photobooth Environment Variables (Vercel & Supabase)
# =====================================================================

# Server Port (Local)
PORT=8000

# ---------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Wajib untuk Vercel Hosting)
# Dapatkan dari: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Gunakan service_role key untuk backend agar bypass RLS saat menulis data
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase anon key (opsional jika sudah ada service_role key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Nama Bucket Storage untuk foto sementara
SUPABASE_BUCKET=photobooth-temp

# ---------------------------------------------------------------------
# 2. MIDTRANS PAYMENT GATEWAY
# Dapatkan dari: https://dashboard.midtrans.com/
# ---------------------------------------------------------------------
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
MIDTRANS_MERCHANT_ID=G123456789
